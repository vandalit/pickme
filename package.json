{
  "name": "pickme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsc src/lib/avatarAssigner.ts src/lib/avatars.ts src/lib/csvImporter.ts --module commonjs --target es2022 --skipLibCheck --outDir dist/lib && node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "db:seed": "tsc prisma/seed.ts --module commonjs --target es2022 --skipLibCheck --outDir prisma/dist && node prisma/dist/prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/dist/prisma/seed.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "pusher-js": "^8.6.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "typescript": "^5"
  }
}
